{
  "name": "catlabinteractive/openid-connect-client",
  "type": "library",
  "description": "OpenID connect module for Neuron network.",
  "keywords": ["framework"],
  "homepage":"https://github.com/CatLabInteractive/OpenID-Connect-Client",
  "license": "MIT",

  "repositories": [
	{
	  "type": "vcs",
	  "url": "https://github.com/catlabinteractive/openid-connect-client"
	}
  ],

  "require": {
	"php": ">=8.1",
	"catlabinteractive/neuron": ">=3.0.0",
	"guzzlehttp/guzzle": "^6.3|^7.0",
    "catlabinteractive/samesite-cookie-sniffer": "dev-master"
  },

  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },

  "authors" : [
	{
	  "name": "Thijs Van der Schaeghe",
	  "email" : "info@catlab.be",
	  "homepage" : "https://www.catlab.eu/",
	  "role" : "Developer"
	}
  ],
  "autoload": {
	"psr-4" : {
	  "CatLab\\OpenIDClient\\" : "src/CatLab/OpenIDClient"
	}
  },

  "autoload-dev": {
	"psr-4" : {
	  "Tests\\" : "tests/"
	}
  }
}
